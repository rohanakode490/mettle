# Mettle App Environment Variables Example
# Duplicate this file to .env or .env.local and replace the values with your project configuration.

# Supabase API Credentials (prefixed with EXPO_PUBLIC_ to expose them to the client app bundle)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-api-key
